{
	"states": [
	{
		"name":"Idle",
		"onEnter":[
		{	"type":"SetAnimation", "animation":"idle" },
		{	"type":"StartTimer", "name": "idleTimer", "duration": { "type": "random_range", "min": 1.0, "max": 1.5 }}
		],
		"onUpdate": [
        { "type": "TickTimer", "name": "idleTimer" }
		]
	},
    {
      "name": "Move",
      "onEnter": [
	    { "type": "SetAnimation", "animation": "move" },
		{ "type": "SetTarget", "area": "playable", "radius": 100, "width": 800, "height":400 }
      ],
      "onUpdate": [
        { "type": "MoveTowardsTarget", "speed": 120 }
      ]
    },
	{
      "name": "PrepareAttack",
      "onEnter": [
	    { "type": "SetAnimation", "animation": "prepare_attack" },
		{ "type": "FaceCenter" }
      ],
      "onUpdate": [
        { 
		  "type": "DrawWarningSign", 		  
	      "offsetX": -10,
		  "offsetY": -50
		}
      ]
    },
    {
	  "name": "Attack_0",
	  "onEnter": [
		{ "type": "SetAnimation", "animation": "attack_0" },
		{
		  "type": "SetTarget",
		  "area": "through_playable_center",
		  "travelDistance": 300
		},
		{
		  "type": "SpawnVisualEffect",
		  "animation": "attack_0_effect",
		  "offsetX": 0,
		  "offsetY": 0,
		  "scale": 1,
		  "rotationDeg": 0,
		  "followOwner": true,
		  "layer": "front"
		}
	  ],
	  "onUpdate": [
		{ "type": "MoveTowardsTarget", "speed": 250 }
	  ]
	},
	{
	  "name": "Attack_1",
	  "onEnter": [
		{ "type": "SetAnimation", "animation": "attack_1" },
		{
		  "type": "SpawnProjectileObject",
		  "effect": "pikachu_thunderjolt",
		  "offsetX": 0,
		  "offsetY": 0,
		  "aim": "playable_center",
		  "spreadDegrees": 0,
		  "speed": 300,
		  "spawnDelaySec": 1
		}
	  ]
	}
  ],
  "transitions": [
	{
      "from": "Move",
	  "to": [
			{ "state": "Idle", "weight": 35 },
			{ "state": "Move", "weight": 60 },
			{ "state": "PrepareAttack", "weight": 5 }
	   ],      
	   "conditions": [
       { "type": "DistanceToTargetLess", "value": 0.1 }
      ]
    },
    {
      "from": "Idle",
	  "to": [
			{ "state": "Move", "weight": 15 },
			{ "state": "PrepareAttack", "weight": 85 }
	   ],      
	   "conditions": [
       { "type": "TimerFinished", "name": "idleTimer" }
      ]
    },
    {
      "from": "PrepareAttack",
	  "to": [
			{ "state": "Attack_0", "weight": 60 },
			{ "state": "Attack_1", "weight": 40 }
		
	   ],      
	   "conditions": [
       { "type": "AnimationFinished" }
      ]
    },
	{
	  "from":"Attack_0",
      "to": [
			{ "state": "Move", "weight": 40 },
			{ "state": "Idle", "weight": 60 }
	   ],  
	  "conditions":[
       { "type": "DistanceToTargetLess", "value": 0.1 }
	  ]
	},
	{
	  "from":"Attack_1",
      "to": [
			{ "state": "Move", "weight": 40 },
			{ "state": "Idle", "weight": 60 }
	   ],  
	  "conditions":[
	    {"type":"AnimationFinished"}
	  ]
	}
  ],
  "initialState": "Move"
}