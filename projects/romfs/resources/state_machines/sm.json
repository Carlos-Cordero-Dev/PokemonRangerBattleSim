{
  "states": [
    {
      "name": "Move",
      "onEnter": [
	    { "type": "SetAnimation", "animation": "move" },
		{
		  "type": "SetTarget",
		  "x": { "type": "random_range", "min": 100, "max": 500 },
		  "y": { "type": "random_range", "min": 200, "max": 600 }
		}
      ],
      "onUpdate": [
        { "type": "MoveTowardsTarget", "speed": 120 }
      ]
    },
    {
      "name": "Attack",
      "onEnter": [
	    { "type": "SetAnimation", "animation": "attack" },
        { 
		  "type": "SpawnHazardObject",
		  "effect": "garchomp_claw",
		  "offsetX": 0,"offsetY": 0,
		  "spawnDelaySec":1
		},
        { "type": "StartTimer", "name": "attackTimer", "duration": 1.0 }
      ]
    },
    {
      "name": "Attack2",
      "onEnter": [
	    { "type": "SetAnimation", "animation": "attack" },
		{ 
		  "type": "SpawnProjectileObject",
		  "effect": "garchomp_shot",
		  "offsetX": 0,"offsetY": 0,
		  "dirX":-1,"dirY":0,
		  "speed": 10,
		  "spawnDelaySec":1
		},
        { "type": "StartTimer", "name": "attackTimer", "duration": 1.0 }
      ],
      "onUpdate": [
        { "type": "TickTimer", "name": "attackTimer" }
      ]
    }
  ],

  "transitions": [
    {
      "from": "Move",
	  "to": [
			{ "state": "Attack", "weight": 75 },
			{ "state": "Attack2", "weight": 25 }
	   ],      
	   "conditions": [
       { "type": "DistanceToTargetLess", "value": 10 }
      ]
    },
	{
	  "from":"Attack",
      "to":"Move",
	  "conditions":[
	    {"type":"AnimationFinished"}
	  ]
	},
    {
      "from": "Attack2",
      "to": "Move",
      "conditions": [
        { "type": "TimerFinished", "name": "attackTimer" }
      ]
    }
  ],

  "initialState": "Move"
}